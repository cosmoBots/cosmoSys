<div class="cosmosys-tree-toolbar">
  <%= render partial: 'tree_expand_collapse_controls' %>
  <%= form_tag({ action: :tree, project_id: @project }, method: :get, class: 'cosmosys-tree-negative-form') do %>
    <%= check_box_tag 'include_negative_items', '1', ActiveModel::Type::Boolean.new.cast(params[:include_negative_items]), id: 'cosmosys-tree-include-negative-items' %>
    <%= label_tag 'cosmosys-tree-include-negative-items', l(:label_cosmosys_tree_include_negative_items) %>
    <%= submit_tag l(:button_cosmosys_apply_tree_options), class: 'icon icon-checked' %>
  <% end %>
</div>
