<%= render partial: 'nav', locals: { current: :tree } %>
<%= render partial: 'tree_health_warning', locals: { problem: @tree_health_problem } %>

<% root_entries = Array(@tree_entries) %>
<div class="cosmosys-tree-editor" data-cosmosys-tree-editor>
  <section class="cosmosys-tree-editor-navigation" aria-label="<%= l(:label_cosmosys_tree) %>">
    <div class="cosmosys-tree-editor-heading">
      <h3><%= l(:label_cosmosys_tree) %></h3>
      <% if @can_add_tree_items && @root_item_tracker %>
        <% return_url = url_for(controller: '/cosmosys/items', action: :tree, project_id: @project, only_path: true, cosmosys_editor_mode: 'root') %>
        <% new_url = new_project_issue_path(@project, issue: { tracker_id: @root_item_tracker.id }, back_url: return_url) %>
        <button type="button" class="button-small" data-cosmosys-editor-form-url="<%= new_url %>"><%= l(:button_cosmosys_tree_new_root) %></button>
      <% end %>
    </div>
    <%= render partial: 'tree_toolbar' %>
    <% if root_entries.any? || Array(@tree_orphaned_issues).any? %>
      <div class="cosmosys-tree-scrollbox">
    <div class="box cosmosys-tree-view cosmosys-tree-reorder-view" data-cosmosys-tree="tree" data-focus-issue-id="<%= @tree_focus_issue&.id %>" data-default-collapsed="true">
      <div class="cosmosys-dnd-dropzone cosmosys-dnd-root-dropzone"
           data-move-mode="root"
           data-drop-parent-id=""
           data-drop-parent-can-have-children="true">
        <span class="cosmosys-dnd-root-label"><%= l(:label_cosmosys_tree_root) %></span>
      </div>
      <ul class="cosmosys-tree-root">
        <% root_entries.each_with_index do |entry, index| %>
          <%= render partial: 'tree_node', locals: { entry: entry, chapter_map: @chapter_map, project: @project, project_ancestor_map: @project_ancestor_map, reorderable_issue_ids: @reorderable_issue_ids, sibling_last: index == root_entries.length - 1, depth: 0 } %>
        <% end %>
      </ul>
      <% if Array(@tree_orphaned_issues).any? %>
        <div class="cosmosys-tree-orphaned">
          <h3 class="cosmosys-tree-orphaned-heading"><%= l(:label_cosmosys_tree_orphaned_items) %></h3>
          <p class="cosmosys-tree-orphaned-help"><%= l(:text_cosmosys_tree_orphaned_items) %></p>
          <ul class="cosmosys-tree-root">
            <% Array(@tree_orphaned_issues).each_with_index do |entry, index| %>
              <%= render partial: 'tree_node', locals: { entry: entry, chapter_map: @chapter_map, project: @project, project_ancestor_map: @project_ancestor_map, reorderable_issue_ids: @reorderable_issue_ids, sibling_last: index == Array(@tree_orphaned_issues).length - 1, depth: 0 } %>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
      </div>

      <%= form_with url: { action: :move, project_id: @project }, method: :post, local: true, html: { id: 'cosmosys-tree-form', class: 'hidden' } do %>
        <%= hidden_field_tag :issue_id, '', id: 'cosmosys-tree-issue-id' %>
        <%= hidden_field_tag :parent_issue_id, '', id: 'cosmosys-tree-parent-id' %>
        <%= hidden_field_tag :target_issue_id, '', id: 'cosmosys-tree-target-id' %>
        <%= hidden_field_tag :move_mode, 'child', id: 'cosmosys-tree-move-mode' %>
      <% end %>
    <% else %>
      <p class="nodata"><%= l(:label_no_data) %></p>
    <% end %>
  </section>

  <section class="cosmosys-tree-editor-workspace" data-cosmosys-tree-sidebar>
    <div class="cosmosys-tree-editor-workspace-heading">
      <h3><%= l(:label_cosmosys_item_editor) %></h3>
      <span><%= l(:text_cosmosys_tree_editor_help) %></span>
    </div>
    <div class="cosmosys-tree-sidebar-body" data-cosmosys-tree-sidebar-body>
      <% if @tree_focus_issue %>
        <%= render partial: 'issue_details', locals: { issue: @tree_focus_issue, editor: true } %>
      <% else %>
        <p class="nodata"><%= l(:text_cosmosys_tree_editor_empty) %></p>
      <% end %>
    </div>
  </section>
</div>
