<%= render partial: 'cosmosys/items/nav', locals: { current: :ods_transfers } %>

<div class="contextual">
  <% if @transfer.applicable? && @transfer.direction == 'materialize' && User.current.admin? %>
    <%= button_to l(:button_cosmosys_materialize_snapshot), materialize_project_cosmosys_ods_transfer_path(@project, @transfer), method: :post, class: 'icon icon-copy' %>
  <% elsif @transfer.applicable? && User.current.allowed_to?(:edit_project, @project) %>
    <%= form_tag apply_project_cosmosys_ods_transfer_path(@project, @transfer), method: :post, data: { cosmosys_ods_import_form: true }, class: 'cosmosys-inline-form' do %>
      <%= submit_tag l(:button_cosmosys_ods_apply), class: 'icon icon-checked', data: { cosmosys_ods_import_submit: true } %>
      <span class="cosmosys-report-export-progress" data-cosmosys-ods-import-progress hidden role="status" aria-live="polite">
        <span class="cosmosys-report-spinner" data-cosmosys-operation-spinner aria-hidden="true"></span>
        <span data-cosmosys-operation-label><%= l(:text_cosmosys_ods_apply_in_progress) %></span>
        <progress value="0" max="100" data-cosmosys-operation-progress>0%</progress>
      </span>
    <% end %>
  <% end %>
  <% if @transfer.export_payload.present? %>
    <%= link_to l(@transfer.direction == 'export' ? :button_cosmosys_ods_download : :button_cosmosys_ods_download_reconciled), download_project_cosmosys_ods_transfer_path(@project, @transfer), class: 'icon icon-download' %>
  <% end %>
</div>

<h2><%= l(:label_cosmosys_ods_transfer) %> #<%= @transfer.id %></h2>

<% if @transfer.direction == 'import' && %w[uploaded analysing applying].include?(@transfer.state) %>
  <div class="cosmosys-report-export-progress"
       data-cosmosys-ods-import-status
       data-status-url="<%= status_project_cosmosys_ods_transfer_path(@project, @transfer) %>"
       role="status" aria-live="polite">
    <span class="cosmosys-report-spinner" data-cosmosys-operation-spinner aria-hidden="true"></span>
    <span data-cosmosys-operation-label><%= l(:text_cosmosys_ods_import_in_progress) %></span>
    <progress value="<%= @transfer.summary['progress'].to_i %>" max="100" data-cosmosys-operation-progress><%= @transfer.summary['progress'].to_i %>%</progress>
  </div>
<% end %>

<div class="box">
  <p><strong><%= l(:field_status) %>:</strong> <%= @transfer.state %></p>
  <p><strong><%= l(:field_filename) %>:</strong> <%= @transfer.original_filename.presence || '-' %></p>
  <% if @transfer.direction == 'export' %>
    <p><strong><%= l(:label_cosmosys_ods_scope) %>:</strong> <%= l(@transfer.include_subprojects? ? :label_cosmosys_ods_scope_tree : :label_cosmosys_ods_scope_project) %></p>
    <p><strong><%= l(:label_cosmosys_ods_export_writer) %>:</strong> <%= l("label_cosmosys_ods_export_writer_#{@transfer.export_writer}".to_sym) %></p>
    <p><strong><%= l(:label_cosmosys_duration) %>:</strong> <%= @transfer.summary['duration_seconds'].present? ? l(:text_cosmosys_duration_seconds, duration: format('%.1f', @transfer.summary['duration_seconds'])) : '-' %></p>
  <% end %>
  <p><strong>SHA-256:</strong> <code><%= @transfer.file_sha256 %></code></p>
  <p><strong><%= l(:label_cosmosys_ods_payload_hash) %>:</strong> <code><%= @transfer.payload_sha256.presence || '-' %></code></p>
  <p><strong><%= l(:label_cosmosys_ods_lineage) %>:</strong> <code><%= @transfer.export_id %></code></p>
  <% if @transfer.summary.present? %>
    <h3><%= l(:label_summary) %></h3>
    <pre><%= JSON.pretty_generate(@transfer.summary) %></pre>
  <% end %>
</div>

<h3><%= l(:label_cosmosys_ods_incidents) %></h3>
<% if @events.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <table class="list">
    <thead><tr><th><%= l(:field_status) %></th><th><%= l(:label_cosmosys_ods_location) %></th><th><%= l(:field_description) %></th></tr></thead>
    <tbody>
      <% @events.each do |event| %>
        <tr class="cosmosys-ods-event-<%= event.severity %>">
          <td><%= event.severity %></td>
          <td><%= [event.sheet, event.row_number && "R#{event.row_number}", event.field_name, event.entity_key].compact.join(' · ') %></td>
          <td><%= event.message %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
