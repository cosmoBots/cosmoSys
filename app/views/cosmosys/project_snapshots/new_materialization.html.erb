<%= render partial: 'cosmosys/items/nav', locals: { current: :snapshots } %>

<h2><%= l(:label_cosmosys_materialize_project_snapshot) %></h2>

<div class="box tabular">
  <%= form_tag materialize_project_cosmosys_snapshot_path(@project, @snapshot), method: :post do %>
    <p><%= label_tag 'destination_name', l(:field_name) %><%= text_field_tag 'destination[name]', @destination['name'], required: true, size: 60 %></p>
    <p><%= label_tag 'destination_identifier', l(:field_identifier) %><%= text_field_tag 'destination[identifier]', @destination['identifier'], required: true, size: 60 %></p>
    <p><%= label_tag 'destination_cscode', 'cscode' %><%= text_field_tag 'destination[cscode]', @destination['cscode'], required: true, size: 20 %></p>
    <p><%= label_tag 'destination_profile', l(:label_cosmosys_project_profile) %><strong><%= @destination['profile'] || @snapshot.manifest.dig('content', 'projects', 0, 'project', 'profile') %></strong></p>
    <p><%= label_tag 'destination_parent_id', l(:field_parent) %><%= select_tag 'destination[parent_id]', options_from_collection_for_select(@parent_projects, :id, :name, @destination['parent_id']), include_blank: l(:label_none) %></p>
    <p>
      <label><%= l(:field_cosmosys_identity_mode) %></label>
      <%= radio_button_tag 'destination[identity_mode]', 'preserve', @destination['identity_mode'].to_s != 'new' %> <%= l(:label_cosmosys_identity_mode_preserve) %>
      <%= radio_button_tag 'destination[identity_mode]', 'new', @destination['identity_mode'].to_s == 'new' %> <%= l(:label_cosmosys_identity_mode_new) %>
      <em class="info"><%= l(:text_cosmosys_identity_mode_help) %></em>
    </p>
    <p>
      <label><%= l(:field_cosmosys_project_data_conflict_policy) %></label>
      <% datum_policy = @destination['project_data_conflict_policy'].to_s.presence || 'cancel' %>
      <% Cosmosys::ProjectDataReconciliation::POLICIES.each do |policy| %>
        <%= radio_button_tag 'destination[project_data_conflict_policy]', policy, datum_policy == policy %>
        <%= l("label_cosmosys_project_data_conflict_#{policy}") %>
      <% end %>
      <em class="info"><%= l(:text_cosmosys_project_data_conflict_policy) %></em>
    </p>
    <% if @materialization_plan %>
      <div class="cosmosys-project-copy-preflight">
        <h3><%= l(:label_cosmosys_snapshot_materialization_preflight) %></h3>
        <p class="warning"><%= l(:text_cosmosys_snapshot_materialization_confirmation) %></p>
        <% @materialization_plan.blocking_messages.each do |message| %>
          <p class="error"><%= message %></p>
        <% end %>
        <%= hidden_field_tag :confirmed_plan, @materialization_plan.confirmation_token %>
        <table class="list">
          <thead><tr><th><%= l(:label_cosmosys_copy_preflight_content) %></th><th><%= l(:label_cosmosys_copy_count) %></th></tr></thead>
          <tbody>
            <% @materialization_plan.counts.each do |kind, count| %>
              <tr><td><%= l("label_cosmosys_snapshot_count_#{kind}") %></td><td><%= count %></td></tr>
            <% end %>
          </tbody>
        </table>
        <% if @materialization_plan.project_data_reconciliation.entries.any? %>
          <h4><%= l(:label_cosmosys_project_data_reconciliation) %></h4>
          <table class="list">
            <thead><tr><th><%= l(:field_cosmosys_datum_key) %></th><th><%= l(:field_status) %></th><th><%= l(:field_subject) %></th><th><%= l(:field_cosmosys_datum_value) %></th></tr></thead>
            <tbody>
              <% @materialization_plan.project_data_reconciliation.entries.each do |entry| %>
                <tr class="<%= 'warning' if entry[:status] == 'conflict' %>">
                  <td><%= entry[:key] %></td><td><%= l("label_cosmosys_project_data_#{entry[:status]}") %></td>
                  <td><%= entry[:target_visible] ? entry[:target_name] : l(:label_cosmosys_project_data_hidden) %> → <%= entry[:source_name] %></td>
                  <td><%= entry[:target_visible] ? entry[:target_value] : l(:label_cosmosys_project_data_hidden) %> → <%= entry[:source_value] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
        <h4><%= l(:label_cosmosys_snapshot_plugins) %></h4>
        <p class="info"><%= l(:text_cosmosys_snapshot_plugin_compatibility) %></p>
        <table class="list">
          <thead><tr><th><%= l(:field_name) %></th><th><%= l(:label_cosmosys_snapshot_source_version) %></th><th><%= l(:label_cosmosys_snapshot_destination_version) %></th><th><%= l(:field_status) %></th></tr></thead>
          <tbody>
            <% @materialization_plan.plugin_compatibility.each do |plugin| %>
              <tr class="<%= 'warning' if %w[missing older].include?(plugin[:status]) %>">
                <td><%= plugin[:name] %> (<code><%= plugin[:id] %></code>)</td>
                <td><%= plugin[:source_version] %></td>
                <td><%= plugin[:destination_version].presence || '—' %></td>
                <td><%= l("label_cosmosys_snapshot_plugin_#{plugin[:status]}") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p class="info"><%= l(:text_cosmosys_snapshot_internal_relations_only) %></p>
      </div>
    <% end %>
    <p><%= submit_tag l(:button_cosmosys_materialize_project_snapshot), class: 'button-positive' %></p>
  <% end %>
</div>
