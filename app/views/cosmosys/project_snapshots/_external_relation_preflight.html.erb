<% entries = plan.external_relation_reconciliation %>
<% if entries.any? %>
  <h4><%= l(:label_cosmosys_snapshot_external_relations) %></h4>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:label_cosmosys_copy_relation_type) %></th>
        <th><%= l(:label_cosmosys_copy_external_item) %></th>
        <th><%= l(:field_status) %></th>
      </tr>
    </thead>
    <tbody>
      <% entries.each do |entry| %>
        <tr class="<%= 'warning' unless entry[:classification] == 'resolved' %>">
          <td><%= entry[:relation_type] %></td>
          <td><code><%= entry[:external_project_identifier] %> / <%= entry[:external_csid] %></code></td>
          <td><%= l("label_cosmosys_snapshot_external_relation_#{entry[:classification]}") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
