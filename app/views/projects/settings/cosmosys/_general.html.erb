    <h3><%= l(:label_cosmosys_project_profile) %></h3>
    <p><%= select_tag 'cosmosys_setting[project_profile]', options_for_select(Cosmosys::ProjectProfileRegistry.all.map { |profile| [l(profile.label), profile.key] }, @project.csys_project_profile), id: 'cosmosys_setting_project_profile' %></p>
    <%= hidden_field_tag 'cosmosys_setting[current_project_profile]', @project.csys_project_profile, id: 'cosmosys_setting_current_project_profile' %>
    <div id="cosmosys-project-profile-impact" class="cosmosys-project-profile-impact" hidden>
      <p><strong><%= l(:label_cosmosys_project_profile_impact) %></strong></p>
      <% Cosmosys::ProjectProfileRegistry.all.each do |profile| %>
        <% impact = @project.cosmosys_profile_module_impact(profile.key) %>
        <div data-cosmosys-profile-impact="<%= profile.key %>" hidden>
          <p><%= l(:text_cosmosys_project_profile_impact_help, profile: l(profile.label)) %></p>
          <ul>
            <li><%= l(:label_cosmosys_modules_enabled_by_migration, modules: impact[:enable].presence&.map { |name| l_or_humanize(name, prefix: 'project_module_') }&.join(', ') || l(:label_none)) %></li>
            <li><%= l(:label_cosmosys_modules_disabled_by_migration, modules: impact[:disable].presence&.map { |name| l_or_humanize(name, prefix: 'project_module_') }&.join(', ') || l(:label_none)) %></li>
            <li><%= l(:label_cosmosys_modules_required_by_profile, modules: impact[:required].presence&.map { |name| l_or_humanize(name, prefix: 'project_module_') }&.join(', ') || l(:label_none)) %></li>
          </ul>
        </div>
      <% end %>
      <label class="block">
        <%= check_box_tag 'cosmosys_setting[confirm_profile_reconfiguration]', '1', false, id: 'cosmosys_setting_confirm_profile_reconfiguration' %>
        <%= l(:label_cosmosys_confirm_project_profile_reconfiguration) %>
      </label>
    </div>
    <%= javascript_tag do %>
      document.addEventListener('DOMContentLoaded', function() {
        var selector = document.getElementById('cosmosys_setting_project_profile');
        var current = document.getElementById('cosmosys_setting_current_project_profile');
        var container = document.getElementById('cosmosys-project-profile-impact');
        var confirmation = document.getElementById('cosmosys_setting_confirm_profile_reconfiguration');
        if (!selector || !current || !container || !confirmation) return;
        var refreshImpact = function() {
          var changed = selector.value !== current.value;
          container.hidden = !changed;
          container.querySelectorAll('[data-cosmosys-profile-impact]').forEach(function(panel) {
            panel.hidden = !changed || panel.dataset.cosmosysProfileImpact !== selector.value;
          });
          confirmation.required = changed;
          if (!changed) confirmation.checked = false;
        };
        selector.addEventListener('change', refreshImpact);
        refreshImpact();
      });
    <% end %>
    <p>
      <%= label_tag 'cosmosys_setting_language', l(:field_cosmosys_language) %>
      <%= select_tag 'cosmosys_setting[language]',
                     options_for_select([[l(:label_cosmosys_inherit_official_language, language: @project.cosmosys_effective_language), '']] + lang_options_for_select(false), @project.csys_language),
                     id: 'cosmosys_setting_language' %>
      <em class="info"><%= l(:text_cosmosys_project_language_help, language: @project.cosmosys_effective_language) %></em>
    </p>
    <p><%= select_tag 'cosmosys_setting[root_tracker_key]', options_for_select([[l(:label_cosmosys_root_tracker_inherit), 'inherit'], [l(:label_cosmosys_root_tracker_free), 'free']] + @project.trackers.where.not(csys_key: nil).map { |tracker| [tracker.name, tracker.csys_key] }, @project.csys_root_tracker_key.presence || 'inherit') %></p>
    <p class="info"><%= l(:text_cosmosys_project_profile_help) %></p>
    <% template_resolution = @project.cosmosys_effective_ods_template %>
    <h4><%= l(:label_cosmosys_ods_template) %></h4>
    <p>
      <%= select_tag 'cosmosys_setting[ods_template_asset_id]', options_for_select([[l(:label_cosmosys_inherit_profile_template), '']] + Cosmosys::TemplateAsset.available_ods.map { |asset| [asset.name, asset.id] }, @project.csys_ods_template_asset_id) %>
      <% template_source = template_resolution.asset ? l(:text_cosmosys_template_asset_source, template: template_resolution.asset.name, project: template_resolution.source_project.name) : l(:text_cosmosys_template_profile_source, profile: l(template_resolution.profile.label)) %>
      <em class="info"><%= l(:text_cosmosys_effective_template, source: template_source) %></em>
    </p>
    <p class="buttons">
      <%= link_to l(:button_cosmosys_download_profile_template), project_cosmosys_profile_template_path(@project), class: 'icon icon-download' %>
      <%= link_to l(:button_cosmosys_download_effective_template), project_cosmosys_effective_template_path(@project), class: 'icon icon-download' %>
    </p>
    <p><em class="info"><%= l(:text_cosmosys_template_download_help) %></em></p>
    <h4><%= l(:label_cosmosys_project_passphrase) %></h4>
    <p>
      <%= password_field_tag 'cosmosys_setting[project_passphrase]', @project.csys_project_passphrase, autocomplete: 'new-password', placeholder: l(:label_cosmosys_inherit_project_passphrase) %>
      <% passphrase_source = @project.cosmosys_project_passphrase_source %>
      <% source_label = passphrase_source.csys_project_passphrase.present? ? passphrase_source.name : l(:text_cosmosys_project_identifier_default) %>
      <em class="info"><%= l(:text_cosmosys_project_passphrase_help, effective: @project.cosmosys_effective_project_passphrase, source: source_label) %></em>
    </p>
