<% sections = { 'general' => :label_general, 'reports' => :label_cosmosys_settings_reports,
                'items' => :label_cosmosys_settings_items, 'diagrams' => :label_cosmosys_diagrams,
                'branding' => :label_cosmosys_branding } %>
<% section = sections.key?(params[:cosmosys_section]) ? params[:cosmosys_section] : 'general' %>
<div class="cosmosys-project-settings-tabs">
  <%= render partial: 'common/tabs', locals: {
        tabs: sections.map { |key, label| { name: "cosmosys-settings-#{key}", label: label,
          url: settings_project_path(@project, tab: 'cosmosys', cosmosys_section: key) } },
        selected_tab: "cosmosys-settings-#{section}"
      } %>
</div>
<% if section == 'branding' %>
  <%= render 'projects/settings/cosmosys/branding' %>
<% else %>
  <%= form_tag(project_cosmosys_settings_path(@project), method: :put, id: 'cosmosys-settings-form') do %>
    <%= hidden_field_tag :cosmosys_section, section %>
    <div class="box tabular cosmosys-settings-box">
      <%= render "projects/settings/cosmosys/#{section}" %>
    </div>
    <p><%= submit_tag l(:button_cosmosys_save_settings_section, section: l(sections.fetch(section))) %></p>
  <% end %>
<% end %>
