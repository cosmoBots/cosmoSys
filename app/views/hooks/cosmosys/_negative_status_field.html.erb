<% issue = local_assigns[:issue] || @issue %>
<% if issue&.cosmosys_item_kind_key == 'negative' %>
  <% negative_statuses = IssueStatus.where(is_closed: true, csys_closed_outcome: 'unsuccessful').order(:position, :id) %>
  <p id="cosmosys-negative-status-field">
    <%= label_tag 'issue_csys_negative_status_id', l(:label_cosmosys_negative_status) %>
    <%= select_tag(
          'issue[csys_negative_status_id]',
          options_from_collection_for_select(negative_statuses, :id, :name, issue.csys_negative_status_id),
          include_blank: l(:label_cosmosys_all_negative_statuses),
          id: 'issue_csys_negative_status_id'
        ) %>
    <em class="info"><%= l(:text_cosmosys_negative_status_help) %></em>
  </p>
<% end %>