<fieldset class="box tabular cosmosys-project-copy-options">
  <legend><%= l(:label_cosmosys_project_copy_policy) %></legend>
  <p>
    <label><%= l(:field_cosmosys_copy_mode) %></label>
    <%= radio_button_tag 'cosmosys_copy[mode]', 'clean', params.dig(:cosmosys_copy, :mode).to_s != 'faithful' %>
    <%= l(:label_cosmosys_copy_mode_clean) %>
    <%= radio_button_tag 'cosmosys_copy[mode]', 'faithful', params.dig(:cosmosys_copy, :mode).to_s == 'faithful' %>
    <%= l(:label_cosmosys_copy_mode_faithful) %>
  </p>
  <p>
    <label><%= l(:field_cosmosys_identity_mode) %></label>
    <%= radio_button_tag 'cosmosys_copy[identity_mode]', 'new', params.dig(:cosmosys_copy, :identity_mode).to_s != 'preserve' %>
    <%= l(:label_cosmosys_identity_mode_new) %>
    <%= radio_button_tag 'cosmosys_copy[identity_mode]', 'preserve', params.dig(:cosmosys_copy, :identity_mode).to_s == 'preserve' %>
    <%= l(:label_cosmosys_identity_mode_preserve) %>
    <em class="info"><%= l(:text_cosmosys_identity_mode_help) %></em>
  </p>
  <p>
    <label><%= l(:field_cosmosys_archive_baseline) %></label>
    <%= check_box_tag 'cosmosys_copy[archive]', '1', params.dig(:cosmosys_copy, :archive).present? %>
    <em class="info"><%= l(:text_cosmosys_archive_baseline_help) %></em>
  </p>
  <p>
    <label><%= l(:field_cosmosys_project_data_conflict_policy) %></label>
    <% datum_policy = params.dig(:cosmosys_copy, :project_data_conflict_policy).to_s.presence || 'cancel' %>
    <% Cosmosys::ProjectDataReconciliation::POLICIES.each do |policy| %>
      <%= radio_button_tag 'cosmosys_copy[project_data_conflict_policy]', policy, datum_policy == policy %>
      <%= l("label_cosmosys_project_data_conflict_#{policy}") %>
    <% end %>
    <em class="info"><%= l(:text_cosmosys_project_data_conflict_policy) %></em>
  </p>
  <% selected_project_ids = Array(params.dig(:cosmosys_copy, :project_ids)).map(&:to_s) %>
  <% selected_project_ids = [@source_project.id.to_s] if selected_project_ids.empty? %>
  <div class="cosmosys-copy-project-selection">
    <h3><%= l(:label_cosmosys_copy_project_selection) %></h3>
    <p><em class="info"><%= l(:text_cosmosys_copy_project_selection) %></em></p>
    <%= hidden_field_tag 'cosmosys_copy[project_ids][]', @source_project.id %>
    <% Array(@cosmosys_copy_projects).each do |project| %>
      <% depth = project.ancestors.count %>
      <label style="display: block; margin-inline-start: <%= depth * 1.5 %>em">
        <%= check_box_tag 'cosmosys_copy[project_ids][]', project.id,
                          selected_project_ids.include?(project.id.to_s),
                          disabled: project == @source_project %>
        <%= project.name %>
      </label>
    <% end %>
  </div>
  <p><em class="info"><%= l(:text_cosmosys_project_copy_preflight, items: @source_project.issues.count, documents: @source_project.documents.count, members: @source_project.members.count) %></em></p>
  <%= render partial: 'hooks/cosmosys/project_copy_preflight', locals: { plan: @cosmosys_copy_plan } if @cosmosys_copy_plan %>
</fieldset>
