<div class="cosmosys-project-copy-preflight">
  <h3><%= l(:label_cosmosys_copy_preflight_review) %></h3>
  <p class="warning"><%= l(plan.executable? ? :text_cosmosys_copy_preflight_confirmation : :text_cosmosys_copy_multi_preview_only) %></p>
  <%= hidden_field_tag 'cosmosys_copy[confirmed_plan]', plan.confirmation_token %>

  <% if plan.multi_project? %>
    <h4><%= l(:label_cosmosys_copy_destination_tree) %></h4>
    <table class="list">
      <thead><tr><th><%= l(:label_cosmosys_copy_source_project) %></th><th><%= l(:label_cosmosys_copy_destination_project) %></th><th><%= l(:field_identifier) %></th></tr></thead>
      <tbody>
        <% plan.destination_projects.each do |entry| %>
          <tr>
            <td><%= entry.fetch(:source).fetch('name') %></td>
            <td><%= entry.fetch(:name) %></td>
            <td>
              <% if plan.primary_project?(entry) %>
                <%= entry.fetch(:identifier) %>
              <% else %>
                <% source_id = entry.fetch(:key).delete_prefix('project:') %>
                <%= text_field_tag "cosmosys_copy[project_identifiers][#{source_id}]", entry.fetch(:identifier), size: 35 %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <% if plan.multi_project? %>
    <p><em class="info"><%= l(:text_cosmosys_copy_identifier_overrides) %></em></p>
  <% end %>

  <table class="list">
    <thead>
      <tr>
        <th><%= l(:label_cosmosys_copy_preflight_content) %></th>
        <th><%= l(:label_cosmosys_copy_count) %></th>
      </tr>
    </thead>
    <tbody>
      <% plan.counts.each do |kind, count| %>
        <tr><td><%= l("label_cosmosys_copy_count_#{kind}") %></td><td><%= count %></td></tr>
      <% end %>
    </tbody>
  </table>

  <% reconciliation = plan.respond_to?(:project_data_reconciliation) ? plan.project_data_reconciliation : plan.materialization_plan.project_data_reconciliation %>
  <% if reconciliation.entries.any? %>
    <h4><%= l(:label_cosmosys_project_data_reconciliation) %></h4>
    <table class="list">
      <thead><tr><th><%= l(:field_cosmosys_datum_key) %></th><th><%= l(:field_status) %></th><th><%= l(:field_subject) %></th><th><%= l(:field_cosmosys_datum_value) %></th></tr></thead>
      <tbody>
        <% reconciliation.entries.each do |entry| %>
          <tr class="<%= 'warning' if entry[:status] == 'conflict' %>">
            <td><%= entry[:key] %></td>
            <td><%= l("label_cosmosys_project_data_#{entry[:status]}") %></td>
            <td><%= entry[:target_visible] ? entry[:target_name] : l(:label_cosmosys_project_data_hidden) %> → <%= entry[:source_name] %></td>
            <td><%= entry[:target_visible] ? entry[:target_value] : l(:label_cosmosys_project_data_hidden) %> → <%= entry[:source_value] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if plan.external_relations.any? %>
    <h4><%= l(:label_cosmosys_copy_external_relations) %></h4>
    <table class="list">
      <thead>
        <tr>
          <th><%= l(:label_cosmosys_copy_relation_type) %></th>
          <th><%= l(:label_cosmosys_copy_external_item) %></th>
          <th><%= l(:field_project) %></th>
          <th><%= l(:field_status) %></th>
        </tr>
      </thead>
      <tbody>
        <% plan.external_relations.each do |relation| %>
          <tr>
            <td><%= relation[:relation_type] %></td>
            <td><%= relation[:external_csid].presence || "##{relation[:external_source_id]}" %> <%= relation[:external_subject] %></td>
            <td><%= relation[:external_project] %></td>
            <td><%= l("label_cosmosys_copy_relation_#{relation[:classification]}") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p><%= l(:text_cosmosys_copy_no_external_relations) %></p>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var confirmation = document.querySelector('.cosmosys-project-copy-preflight');
    var submit = confirmation && confirmation.closest('form').querySelector('input[type="submit"]');
    if (submit) {
      submit.value = <%= l(plan.executable? ? :button_cosmosys_confirm_copy : :button_cosmosys_copy_multi_not_available).to_json.html_safe %>;
      submit.disabled = <%= (!plan.executable?).to_json %>;
    }
  });
</script>
